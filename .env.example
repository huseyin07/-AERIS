# Existing Arc Mainnet overrides are optional
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_EXPLORER=https://arcscan.app

# Circle Developer-Controlled Wallets — server-side only.
# Reads need API key + UUID wallet ID + public address. Use a dedicated project EOA.
# Verified address and Arc balance are public via /api/agent-wallet.
CIRCLE_API_KEY=
# Reserved for the future signing adapter; not required for wallet observation.
CIRCLE_ENTITY_SECRET=
CIRCLE_EVM_WALLET_ID=
CIRCLE_EVM_WALLET_ADDRESS=

# Signing is not implemented. This flag alone cannot enable execution.
AERIS_CIRCLE_EXECUTION_ENABLED=false
