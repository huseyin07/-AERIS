  "scripts": {
    "test": "npm run test:activity && npm run test:intelligence && npm run test:entity-types && npm run test:agent-policy && npm run test:agent-decision && npm run test:agent-runtime && npm run test:circle-execution",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:intelligence": "node --import tsx --test tests/intelligence.test.mjs",
    "test:activity": "node --import tsx --test tests/activity-source.test.mjs",
    "test:entity-types": "node --import tsx --test tests/entity-classifier.test.mjs",
    "test:agent-policy": "node --import tsx --test tests/agent-policy.test.mjs",
    "test:agent-decision": "node --import tsx --test tests/agent-decision.test.mjs",
    "test:agent-runtime": "node --import tsx --test tests/agent-runtime.test.mjs",
    "test:circle-execution": "node --import tsx --test tests/circle-execution.test.mjs tests/circle-wallet.test.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@vercel/speed-insights": "^2.0.0",
    "next": "14.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.168.0",
    "viem": "^2.21.16",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
