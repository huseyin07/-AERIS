  "private": true,
  "scripts": {
    "test": "npm run test:activity && npm run test:intelligence && npm run test:entity-types && npm run test:agent-policy && npm run test:agent-decision && npm run test:agent-runtime && npm run test:circle-execution && npm run test:watchlist && npm run test:payments",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:intelligence": "node --import tsx --test tests/intelligence.test.mjs",
    "test:activity": "node --import tsx --test tests/activity-source.test.mjs",
    "test:entity-types": "node --import tsx --test tests/entity-classifier.test.mjs",
    "test:agent-policy": "node --import tsx --test tests/agent-policy.test.mjs",
    "test:agent-decision": "node --import tsx --test tests/agent-decision.test.mjs",
    "test:agent-runtime": "node --import tsx --test tests/agent-runtime.test.mjs",
    "test:circle-execution": "node --import tsx --test tests/circle-execution.test.mjs tests/circle-wallet.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:watchlist": "node --import tsx --test tests/watchlist.test.mjs",
    "test:payments": "node --import tsx --test tests/payments.test.mjs tests/payment-planner.test.mjs tests/payment-workspace.test.mjs tests/visitor-wallet.test.mjs tests/public-wallet-completion.test.mjs",
